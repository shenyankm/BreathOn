# 后端配置：密钥仅由服务端读取，修改后需重启后端。

# 本机开发可免登录；公网部署必须设为 true 并配置管理员密码哈希。
# 使用 uv run --directory backend python -m medvisit.api.auth 生成哈希。
AUTH_REQUIRED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# 多账号使用 JSON 对象，键为账号、值为上述 scrypt 哈希；设置后覆盖单管理员配置。
# 共享资料、医生、场景和量表；演练记录、点评、重练、案例及统计按账号隔离。
LOGIN_USERS_JSON={}

# DeepSeek：AI 分析与对话总结（两种模式共用）
# 练习模式：实时教练分析，并生成医生文字回应。
# 实战模式：演练结束后生成整场对话总结与复盘。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 模型并发按账号计算：Flash 2500，deepseek-v4-pro 500；切换模型时同步调整。
DEEPSEEK_MAX_CONCURRENCY=2500
# Search/Fetch 独立QPS额度，不与模型并发混用。均为当前进程的保护上限。
DEEPSEEK_SEARCH_ENABLED=true
DEEPSEEK_SEARCH_QPS=100
DEEPSEEK_FETCH_QPS=25

# SeedASR：语音转写（两种模式共用）
# 将学员语音转为文字，作为 AI 分析与对话总结的原文。
# 使用豆包语音控制台 API Key，需开通 volc.seedasr.sauc.duration 资源。
SEEDASR_API_KEY=

# 练习模式：医生语音合成
# 将医生开场白及文字回应合成为语音；不朗读教练分析。
# 使用豆包 TTS 2.0；默认云舟 2.0 支持语气指令，更换时需选择支持指令遵循的 2.0 音色。
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_VOICE=zh_male_m191_uranus_bigtts

# 实战模式：实时语音对话
# 使用 Seeduplex 进行双向语音对话；学员原文由上方 SeedASR 转写。
# DOUBAO_API_KEY 使用豆包语音控制台 API Key，不是 AK/SK 或文本模型 endpoint ID。
DOUBAO_API_KEY=
DOUBAO_VOICE=zh_male_xiaotian_jupiter_bigtts

# 服务与存储
# ALLOWED_ORIGINS 为允许 HTTP 写入和 WebSocket 的完整前端来源，多个地址以逗号分隔。
# 仅填协议、主机与端口，不带路径、末尾斜线、查询参数或通配符。
# DATABASE_URL 留空时使用本地 JSON；Docker Compose 自动设置 PostgreSQL 连接。
# RECORDS_DIR 留空时使用 backend/data/sessions；自定义时建议使用绝对路径。
# PostgreSQL 模式的检索归档仍保存在该目录，备份时需同时保留。
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=
RECORDS_DIR=

