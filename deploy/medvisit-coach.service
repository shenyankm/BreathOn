[Unit]
Description=EviSpeak TypeScript API and Pi agents
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=10001
Group=10001
WorkingDirectory=/srv/medvisit-coach/current/backend
EnvironmentFile=/etc/medvisit-coach/backend.env
EnvironmentFile=/etc/medvisit-coach/native.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# Keep stored absolute paths valid without copying or exposing the Docker volume roots.
BindPaths=/var/lib/docker/volumes/medvisit-coach_research_data/_data:/app/data/sessions
BindPaths=/var/lib/docker/volumes/medvisit-coach_visit_audio/_data:/app/data/visit-audio
ReadWritePaths=/app/data/sessions /app/data/visit-audio
ExecStart=/usr/bin/env AUTH_REQUIRED=true ALLOWED_ORIGINS=https://openwook.cloud,https://www.openwook.cloud DATABASE_URL=postgresql:// PGHOST=127.0.0.1 PGPORT=5432 RECORDS_DIR=/app/data/sessions HOST=127.0.0.1 PORT=8000 PATH=/usr/local/bin:/usr/bin:/bin node dist/main.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
